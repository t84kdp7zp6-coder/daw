---
interface Props {
  label: string;
  variant?: "solid" | "outline" | "onImage";
  class?: string;
}
const { label, variant = "outline", class: className = "" } = Astro.props;

const variants = {
  solid: "bg-neutral-900 text-white",
  outline: "bg-white border border-neutral-200 text-neutral-600",
  onImage: "bg-white text-neutral-900",
};
---

<span class={`inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ${variants[variant]} ${className}`}>
  {label}
</span>
